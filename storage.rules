rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /enrollments/{enrollmentId}/{allPaths=**} {
      allow write: if request.auth != null;
      allow read:  if request.auth != null;
    }
    match /medical/{docId}/{allPaths=**} {
      allow write: if request.auth != null;
      allow read:  if request.auth != null;
    }
  }
}
